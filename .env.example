# 默认 PostgreSQL；用户名和密码是仅供本地开发的占位值。
DATABASE_URL=postgresql+psycopg://wonder:wonder@localhost:5432/wonder
# 无 Docker 时可改为 sqlite:///./wonder.db，然后执行 Alembic upgrade head。
MOCK_MODE=true
# 默认通用兼容服务；百炼准备阶段改为 bailian，但继续保留 MOCK_MODE=true。
MODEL_PROVIDER=openai-compatible
MODEL_API_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=gpt-4o-mini
MODEL_TIMEOUT=30
MODEL_MAX_RETRIES=1
MODEL_MAX_TOKENS=2048
# 百炼北京示例（仅示例，不可直接请求；不要将真实 Host/Key 写进本文件）：
# MODEL_PROVIDER=bailian
# MODEL_NAME=qwen3.8-flash
# MODEL_API_BASE_URL=https://example.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# MODEL_MAX_RETRIES=0
# MODEL_API_KEY 只在本地 .env 或环境变量填写；本阶段不启用真实调用。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
