# 默认 PostgreSQL；用户名和密码是仅供本地开发的占位值。
DATABASE_URL=postgresql+psycopg://wonder:wonder@localhost:5432/wonder
# 无 Docker 时可改为 sqlite:///./wonder.db，然后执行 Alembic upgrade head。
MOCK_MODE=true
MODEL_API_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=gpt-4o-mini
MODEL_TIMEOUT=30
MODEL_MAX_RETRIES=1
MODEL_MAX_TOKENS=2048
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
